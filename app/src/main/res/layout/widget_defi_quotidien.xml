<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fond"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_vide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aucun profil"
        android:textColor="@color/widget_texte_muet"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ligne_joueurs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/cadre_1"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginVertical="2dp"
            android:layout_marginHorizontal="6dp"
            android:orientation="vertical"
            android:background="@drawable/widget_cadre_neutre"
            android:padding="4dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/widget_cadre_interieur"
                android:padding="2dp">
                <TextView
                    android:id="@+id/nom_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_texte"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center" />
                <TextView
                    android:id="@+id/statut_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_texte_muet"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
